{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bonsai visual assessment",
  "type": "object",
  "required": ["assessment_id", "image", "subject", "assessment_confidence", "health_gate", "scores", "evidence", "verdict", "matched_lines", "plan"],
  "properties": {
    "assessment_id": {"type": "string"},
    "image": {"type": "object", "required": ["path", "fitness_notes"], "properties": {"path": {"type": "string"}, "fitness_notes": {"type": "array", "items": {"type": "string"}}}},
    "subject": {
      "type": "object",
      "required": ["display_name", "species_candidates", "school_profile", "form_style"],
      "properties": {
        "display_name": {"type": "string"},
        "species_candidates": {"type": "array", "maxItems": 3, "items": {"type": "object", "required": ["name", "confidence", "evidence"], "properties": {"name": {"type": "string"}, "latin": {"type": "string"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "evidence": {"type": "string"}}}},
        "school_profile": {"type": "string", "enum": ["lingnan", "yangzhou", "suzhou", "sichuan", "shanghai", "anhui", "nantong", "zhejiang", "unaffiliated"]},
        "form_style": {"type": "string"}
      }
    },
    "assessment_confidence": {"type": "integer", "minimum": 0, "maximum": 100},
    "health_gate": {"type": "string", "enum": ["none", "watch", "intervention", "critical"]},
    "scores": {
      "type": "object",
      "required": ["far_view", "middle_view", "near_view", "living_view", "school_fit"],
      "properties": {
        "far_view": {"$ref": "#/$defs/scoreGroup"},
        "middle_view": {"$ref": "#/$defs/scoreGroup"},
        "near_view": {"$ref": "#/$defs/scoreGroup"},
        "living_view": {"$ref": "#/$defs/scoreGroup"},
        "school_fit": {"$ref": "#/$defs/scoreGroup"},
        "base_total": {"type": "number"},
        "raw_total": {"type": "number"},
        "final_total": {"type": "number"},
        "grade": {"type": "string"},
        "uncertainty": {"type": "number"}
      }
    },
    "evidence": {"type": "array", "items": {"type": "object", "required": ["id", "label", "bbox", "observation", "confidence"], "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "bbox": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0, "maximum": 1}}, "observation": {"type": "string"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}}},
    "verdict": {"type": "object", "required": ["one_liner", "strengths", "weaknesses", "not_judged"], "properties": {"one_liner": {"type": "string"}, "strengths": {"type": "array", "items": {"type": "string"}}, "weaknesses": {"type": "array", "items": {"type": "string"}}, "not_judged": {"type": "array", "items": {"type": "string"}}}},
    "matched_lines": {"type": "object", "required": ["praise", "improve"], "properties": {"praise": {"type": "string"}, "improve": {"type": "string"}}},
    "plan": {"type": "object", "required": ["now_7_days", "next_season", "one_to_three_years"], "properties": {"now_7_days": {"type": "array", "items": {"$ref": "#/$defs/action"}}, "next_season": {"type": "array", "items": {"$ref": "#/$defs/action"}}, "one_to_three_years": {"type": "array", "items": {"$ref": "#/$defs/action"}}}}
  },
  "$defs": {
    "scoreItem": {"type": "object", "required": ["label", "score", "max", "reason", "evidence_ids"], "properties": {"label": {"type": "string"}, "score": {"type": "number", "minimum": 0}, "max": {"type": "number", "exclusiveMinimum": 0}, "reason": {"type": "string"}, "evidence_ids": {"type": "array", "items": {"type": "string"}}}},
    "scoreGroup": {"type": "object", "required": ["label", "max", "items"], "properties": {"label": {"type": "string"}, "max": {"type": "number"}, "items": {"type": "array", "items": {"$ref": "#/$defs/scoreItem"}}, "subtotal": {"type": "number"}}},
    "action": {"type": "object", "required": ["action", "why", "timing", "risk"], "properties": {"action": {"type": "string"}, "why": {"type": "string"}, "timing": {"type": "string"}, "risk": {"type": "string", "enum": ["low", "medium", "high"]}, "prerequisites": {"type": "string"}, "expected_effect": {"type": "string"}, "avoid_if": {"type": "string"}}}
  }
}

