{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Witch Floral Judge assessment",
  "type": "object",
  "required": ["assessment_id", "mode", "style", "evidence", "rule_status", "scores", "verdict"],
  "properties": {
    "assessment_id": {"type": "string"},
    "mode": {"type": "string", "enum": ["image", "brief", "competition", "photo_art"]},
    "style": {
      "type": "object",
      "required": ["declared", "confidence"],
      "properties": {
        "declared": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "assumptions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "image_fitness": {
      "type": "object",
      "properties": {
        "view_count": {"type": "integer", "minimum": 0},
        "notes": {"type": "array", "items": {"type": "string"}},
        "coverage": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "rule_status": {
      "type": "object",
      "required": ["status", "items"],
      "properties": {
        "status": {"type": "string", "enum": ["pass", "deduction", "disqualification_risk", "unknown"]},
        "items": {"type": "array", "items": {"type": "string"}}
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "observation", "confidence"],
        "properties": {
          "id": {"type": "string"},
          "bbox": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0, "maximum": 1}},
          "observation": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "scores": {
      "type": "object",
      "required": ["domains", "assessed_points", "assessed_max", "confidence"],
      "properties": {
        "domains": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "label", "max", "items"],
            "properties": {
              "key": {"type": "string"},
              "label": {"type": "string"},
              "max": {"type": "number", "exclusiveMinimum": 0},
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["label", "status", "reason"],
                  "properties": {
                    "label": {"type": "string"},
                    "status": {"type": "string", "enum": ["scored", "N/A"]},
                    "score": {"type": ["number", "null"]},
                    "max": {"type": "number"},
                    "reason": {"type": "string"},
                    "evidence_ids": {"type": "array", "items": {"type": "string"}}
                  }
                }
              }
            }
          }
        },
        "assessed_points": {"type": "number", "minimum": 0},
        "assessed_max": {"type": "number", "minimum": 0},
        "total_points": {"type": "number", "minimum": 0},
        "total_max": {"type": "number", "minimum": 0},
        "coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 100},
        "grade": {"type": "string"},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "verdict": {
      "type": "object",
      "required": ["one_liner", "strengths", "improvements", "not_judged"],
      "properties": {
        "one_liner": {"type": "string"},
        "strengths": {"type": "array", "items": {"type": "string"}},
        "improvements": {"type": "array", "items": {"type": "string"}},
        "not_judged": {"type": "array", "items": {"type": "string"}},
        "next_evidence": {"type": "string"}
      }
    }
  }
}
